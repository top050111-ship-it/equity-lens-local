TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
LLM_BACKEND=ollama
LLM_MODEL=qwen3:4b
OLLAMA_THINK=false
OLLAMA_PARALLEL_AGENTS=false
OLLAMA_NUM_PREDICT=4800
OLLAMA_NUM_CTX=16384
OPENAI_API_KEY=
FRED_API_KEY=
EQUITY_LENS_URL=
EQUITY_LENS_TOKEN=

# local: 내 컴퓨터 전용 API / public: 가상 시연만 (실제 자료 API 차단)
APP_MODE=local
# 기존 수집기 data 폴더의 절대 경로. 비워 두면 이 backend/data를 사용.
EQUITY_DATA_DIR=

# live: 토스 실계좌 조회 / cached: 저장 포트폴리오 + 공개 시세/뉴스 + 실제 AI (토스 키 불필요)
EQUITY_HOLDINGS_MODE=live
# 별도 저장 포트폴리오 경로; 비우면 data/frozen_portfolio.json, last_nonempty_portfolio.json 순서
EQUITY_RESEARCH_FILE=
EQUITY_STREAM=true
# 전체 CLI 작업 제한(초), 모델 개별 호출은 재시도 없이 기본 900초
EQUITY_JOB_TIMEOUT=7200
OLLAMA_TIMEOUT=900

# DART 무료 인증키(40자리). SEC는 API 키 대신 실제 연락 가능한 이메일이 포함된 User-Agent 사용.
DART_API_KEY=
SEC_USER_AGENT=
# 예시 이메일을 실제 이메일로 바꾼 뒤 SEC를 사용하세요. 빈 값이면 SEC 수집을 건너뜁니다.
# 공시 캐시 경로; 비우면 이 코드 폴더/data/public_cache
EQUITY_PUBLIC_CACHE=
